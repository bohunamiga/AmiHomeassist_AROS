; strings.cd - Katalogbeschreibung fuer AmiHomeassist.
;
; Die hier stehenden Texte sind die EINGEBAUTEN, also Englisch. Sie greifen,
; wenn kein Katalog passt. Uebersetzungen stehen in catalogs/<sprache>.ct.
;
; Format je Eintrag:   MSG_NAME (id//)
;                      Der Text
; Ein fuehrendes _ markiert die Tastaturabkuerzung eines Knopfes.
; Nummern NIE neu vergeben - alte Kataloge wuerden sonst falsche Texte zeigen.
;
#version 0

; ---------------------------------------------------------------- Knoepfe
MSG_BT_REFRESH (0//)
_Refresh
MSG_BT_SELECT (//)
S_elect ...
MSG_BT_EDIT (//)
_Edit ...
MSG_BT_PREFS (//)
Se_ttings ...
MSG_BT_SUGGEST (//)
S_uggest
MSG_BT_ALL (//)
A_ll
MSG_BT_NONE (//)
_None
MSG_BT_APPLY (//)
_Apply
MSG_BT_SAVE (//)
_Save
MSG_BT_CLOSE (//)
_Close

