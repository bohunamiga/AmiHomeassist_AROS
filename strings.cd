; ============================================================ amiha.c
MSG_ERR_NONE (//)
no error
MSG_ERR_NOPREFS (//)
no settings found (ENVARC:AmiHomeassist/AmiHomeassist.prefs)
MSG_ERR_NOHOST (//)
host= is missing from the settings
MSG_ERR_NOTOKEN (//)
token= is missing from the settings
MSG_ERR_PREFSWRITE (//)
cannot write the settings
MSG_ERR_IMPORTWRITE (//)
cannot write the adopted-device list
MSG_ERR_NOSOCKET (//)
bsdsocket.library not available - is the TCP stack up?
MSG_ERR_NORESOLVE (//)
cannot resolve the host name
MSG_ERR_SOCKET (//)
socket() failed
MSG_ERR_REFUSED (//)
connection refused - is Home Assistant running?
MSG_ERR_SEND (//)
sending failed
MSG_ERR_RECV (//)
receiving failed
MSG_ERR_BADRESPONSE (//)
unintelligible response from the server
MSG_ERR_NOBODY (//)
response without a body
MSG_ERR_TOKEN401 (//)
Home Assistant rejects the token (401)
MSG_ERR_HTTP (//)
Home Assistant answers with HTTP %d
MSG_ERR_NODEVICES (//)
Home Assistant returns no devices
MSG_ERR_NOMEMLIST (//)
not enough memory for the device list
MSG_ERR_BADENTITY (//)
unusable entity ID

